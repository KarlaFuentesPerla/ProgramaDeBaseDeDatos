# Copia este archivo como .env y completa los valores (no subas .env a git)

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=

BACKUP_TARGET_DATABASE=restaurante_gestion_1
METADATA_DATABASE=restaurante_gestion_1

CRON_SCHEDULE=30 2 * * *
RETENTION_DAYS=30

# hex 64 chars o base64 de 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Windows (ajusta si MySQL está en otro sitio)
MYSQLDUMP_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQL_CLI_PATH=C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
